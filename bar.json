{
  "api": "https://maestro-agent.duckdns.org",
  "token_service": "maestro-token",
  "audio_device": "",
  "out_dir": "~/Recordings",
  "after_record": {
    "cmd": "",
    "auto_push": true,
    "notify": true
  },
  "sidebar": {
    "enabled": true,
    "hotkey": "<ctrl>+<alt>+m",
    "refresh_seconds": 90,
    "invisible": false,
    "ask_path": "/brain/ask",
    "ask_placeholder": "Ask about clients, meetings, decisions",
    "record": [
      {
        "mode": "audio",
        "label": "Record audio"
      },
      {
        "mode": "screen",
        "label": "Record screen and audio"
      }
    ],
    "sections": [
      {
        "id": "review",
        "title": "Review",
        "symbol": "tray.full",
        "list": "/sales/actions?status=pending",
        "fields": {
          "title": [
            "title",
            "action_label"
          ],
          "subtitle": [
            "client_name",
            "meeting_title"
          ],
          "body": [
            "draft_body",
            "detail"
          ]
        },
        "actions": [
          {
            "label": "Done",
            "method": "PATCH",
            "path": "/sales/actions/{id}",
            "body": {
              "status": "done"
            },
            "toast": "Marked done"
          },
          {
            "label": "Dismiss",
            "method": "PATCH",
            "path": "/sales/actions/{id}",
            "body": {
              "status": "dismissed"
            },
            "toast": "Dismissed"
          },
          {
            "label": "Send the email",
            "path": "/sales/actions/{id}/send",
            "toast": "Sent"
          }
        ],
        "compose": {
          "path": "/sales/actions/{id}/instruct",
          "field": "instruction",
          "placeholder": "Tell the agent what to change",
          "record": false,
          "toast": "Instruction sent"
        }
      },
      {
        "id": "board",
        "title": "Board",
        "symbol": "board",
        "list": "/trello/batches",
        "fields": {
          "title": [
            "title"
          ],
          "subtitle": [
            "subtitle"
          ],
          "body": [
            "detail"
          ]
        },
        "actions": [
          {
            "label": "Keep",
            "method": "POST",
            "path": "/trello/batches/{id}/keep",
            "toast": "Kept"
          },
          {
            "label": "Undo all",
            "method": "POST",
            "path": "/trello/batches/{id}/undo",
            "toast": "Undone on Trello"
          }
        ]
      },
      {
        "id": "capture",
        "title": "Capture",
        "symbol": "square.and.pencil",
        "list": "",
        "actions": [],
        "compose": {
          "path": "",
          "file": "~/Recordings/captures.md",
          "placeholder": "Idea, decision, ticket",
          "record": true,
          "toast": "Captured"
        }
      }
    ]
  }
}
