{
  "api": "https://maestro-agent.duckdns.org",
  "token_service": "maestro-token",
  "audio_device": "",
  "out_dir": "~/Recordings",
  "after_record": {
    "cmd": "",
    "auto_push": true,
    "notify": true
  },
  "sidebar": {
    "enabled": true,
    "hotkey": "<ctrl>+<alt>+m",
    "refresh_seconds": 90,
    "invisible": false,
    "ask_path": "/brain/ask",
    "ask_placeholder": "Ask about clients, meetings, decisions",
    "record": [
      {
        "mode": "audio",
        "label": "Record audio"
      },
      {
        "mode": "screen",
        "label": "Record screen and audio"
      }
    ],
    "sections": [
      {
        "id": "board",
        "title": "Board",
        "symbol": "board",
        "list": "/trello/batches",
        "fields": {
          "title": [
            "title"
          ],
          "subtitle": [
            "subtitle"
          ],
          "body": [
            "detail"
          ]
        },
        "actions": [
          {
            "label": "Keep",
            "method": "POST",
            "path": "/trello/batches/{id}/keep",
            "toast": "Kept"
          },
          {
            "label": "Undo all",
            "method": "POST",
            "path": "/trello/batches/{id}/undo",
            "toast": "Undone on Trello"
          }
        ]
      },
      {
        "id": "storyboards",
        "title": "Storyboards",
        "symbol": "film",
        "list": "/studio/runs",
        "live_seconds": 5,
        "watch_recordings": true,
        "fields": {
          "title": [
            "title"
          ],
          "subtitle": [
            "subtitle"
          ],
          "body": [
            "body"
          ]
        },
        "actions": [
          {
            "label": "Go",
            "symbol": "play",
            "method": "POST",
            "path": "/studio/runs/{id}/go",
            "advance": false,
            "toast": "Started — the card shows progress"
          },
          {
            "label": "Retry",
            "method": "POST",
            "path": "/studio/runs/{id}/retry",
            "advance": false,
            "toast": "Retrying the failed steps"
          },
          {
            "label": "Dismiss",
            "method": "POST",
            "path": "/studio/runs/{id}/dismiss",
            "toast": "Dismissed"
          }
        ],
        "compose": {
          "path": "/studio/runs/{id}/instruct",
          "field": "instruction",
          "placeholder": "Change the plan, or ask for more",
          "record": false,
          "toast": "Understood — the card updates"
        }
      },
      {
        "id": "capture",
        "title": "Capture",
        "symbol": "square.and.pencil",
        "list": "",
        "actions": [],
        "compose": {
          "path": "",
          "file": "~/Recordings/captures.md",
          "placeholder": "Idea, decision, ticket",
          "record": true,
          "toast": "Captured"
        }
      }
    ]
  }
}
